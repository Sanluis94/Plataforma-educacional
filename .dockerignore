# Deny by default. A new credential/export at repository root stays excluded.
**
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.app.json
!tsconfig.node.json
!vite.config.ts
!index.html
!Dockerfile
!.dockerignore
!src/
!src/**
!public/
!public/**
!scripts/
!scripts/cloud/
!scripts/cloud/*.mjs
!deploy/
!deploy/nginx.conf
!deploy/entrypoint.sh

# The source allowlist never overrides private/generated data exclusions.
**/.env*
**/*service*account*
**/*credential*
**/*.pem
**/*.key
**/.local/**
**/node_modules/**
**/*.log
**/*test.ts
**/*test.tsx
**/*.test.mjs
src/test/**
public/local-data/**
public/installation.json
public/release.json
**/*.map

VITE_FIREBASE_API_KEY="SUA_CHAVE_AQUI"
VITE_FIREBASE_AUTH_DOMAIN="SEU_DOMINIO.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="SEU_ID_DE_PROJETO"
VITE_FIREBASE_STORAGE_BUCKET="SEU_BUCKET.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="SEU_SENDER_ID"
VITE_FIREBASE_APP_ID="SUA_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID="SEU_MEASUREMENT_ID"

# Desenvolvimento local opt-in: usa demo-kortex, sem credenciais Firebase reais.
# Ative somente no servidor Vite de desenvolvimento; nunca em builds publicados.
# O comando npm run dev:emulator ativa esse modo automaticamente.
VITE_USE_FIREBASE_EMULATORS="false"
VITE_FIREBASE_EMULATOR_HOST="127.0.0.1"
VITE_FIREBASE_AUTH_EMULATOR_PORT="9099"
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT="8080"

# Identificação pública da instalação. Campos sem definição ficam vazios no piloto.
# Escolas e uso doméstico devem ter projetos Firebase e origens diferentes.
VITE_INSTALLATION_ID=""
VITE_INSTALLATION_NAME="Edu-Interact"
VITE_INSTALLATION_MODE=""
VITE_PUBLIC_RELEASE_STAGE="pilot"
VITE_DATA_CONTROLLER_NAME=""
VITE_DATA_CONTROLLER_DOCUMENT=""
VITE_PRIVACY_CONTACT_EMAIL=""

# VITE_* é entregue ao navegador: nunca coloque chaves privadas nessas variáveis.
# O build de produção remove a chave Gemini; nuvem e uso comercial mantêm IA externa desativada.
VITE_GEMINI_API_KEY=""
# dev:local, dev:emulator e test:local desativam chamadas externas de IA.
VITE_DISABLE_AI="false"

# ETL Firebase/Firestore
ETL_SOURCE="firebase"
ETL_OUTPUT_DIR="./public/local-data/etl"
ETL_API_HOST="127.0.0.1"
ETL_API_PORT="3333"
FIREBASE_PROJECT_ID="SEU_ID_DE_PROJETO"
FIREBASE_SERVICE_ACCOUNT_PATH="./.local/firebase-service-account.json"
